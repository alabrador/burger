# Copia este archivo a .env.local (desarrollo) o pon estas variables en Vercel.

# --- Obligatorias ---

# Postgres (Neon o Supabase). Usa la URL CON pooler para la app.
# Si lo conectaste desde Vercel Storage/Marketplace también vale POSTGRES_URL.
#   Neon:     postgres://usuario:clave@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgres://postgres.xxx:clave@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Conexión directa (sin pooler), solo para migraciones.
# También valen DATABASE_URL_UNPOOLED (Neon) o POSTGRES_URL_NON_POOLING (Supabase).
DATABASE_URL_DIRECT=
DB_POOL_MAX=5

# Redis con protocolo redis:// o rediss:// (Redis Cloud, Upstash…). También vale KV_URL.
# Ojo: las variables UPSTASH_REDIS_REST_* (REST) no sirven; hace falta la URL rediss://.
REDIS_URL=

# Secretos de la app (obligatorios): genera cada uno con  openssl rand -base64 32
APP_SECRET=
APP_ENCRYPTION_KEY=
CRON_SECRET=
# URL pública (sin barra final). En Vercel puedes dejarla vacía en previews.
APP_BASE_URL=https://tudominio.com

# Primer usuario dueño (solo para  npm run db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Solo si el dueño perdió el móvil de los dos pasos: 1 los desactiva en el próximo despliegue (luego bórrala)
# ADMIN_RESET_2FA=1

# --- Opcional: si se definen aquí tienen prioridad sobre lo guardado en /admin ---
# STRIPE_PUBLISHABLE_KEY=   # pk_… → formulario de tarjeta dentro de la web
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# REDSYS_ENV=test
# REDSYS_MERCHANT_CODE=
# REDSYS_TERMINAL=1
# REDSYS_SECRET_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Solo pruebas locales: sin SMTP, escribe los correos (códigos de acceso) en el registro
# MAIL_DEV_LOG=1
